<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_14dp_btn"
    android:backgroundTint="@color/gray_800"
    android:paddingVertical="20dp"
    android:layout_marginBottom="10dp"
    android:paddingHorizontal="12dp">

    <TextView
        android:id="@+id/public_peace_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="내용"
        android:textAppearance="@style/caption1_Semibold"
        android:textColor="@color/white"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/public_peace_date_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="YYYY.MM.DD 기사제목"
        android:textAppearance="@style/caption1_Semibold"
        android:textColor="@color/white"
        android:layout_marginTop="10dp"
        android:background="@drawable/gray_bg20"
        android:backgroundTint="@color/black"
        android:gravity="center"
        android:padding="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/public_peace_desc"/>

</androidx.constraintlayout.widget.ConstraintLayout>