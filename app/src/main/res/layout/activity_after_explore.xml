<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_main_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/after_back_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/back"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/after_my_address_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:layout_marginEnd="20dp"
                    android:text="{서울특별시 동작구 상도로 396}"
                    android:textAppearance="@style/heading2_Semibold"
                    app:layout_constraintStart_toStartOf="@id/after_back_iv"
                    app:layout_constraintTop_toBottomOf="@id/after_back_iv" />

                <TextView
                    android:id="@+id/after_address_des_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="오늘 탐색하는 집에 대한 정보를 측정할게요"
                    android:textAppearance="@style/body2_Median"
                    app:layout_constraintStart_toStartOf="@id/after_my_address_tv"
                    app:layout_constraintTop_toBottomOf="@id/after_my_address_tv" />

                <include
                    android:id="@+id/after_progress_layout"
                    layout="@layout/layout_step_progress_finish"
                    android:layout_width="320dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="34dp"
                    app:layout_constraintStart_toStartOf="@id/after_address_des_tv"
                    app:layout_constraintTop_toBottomOf="@id/after_address_des_tv" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/after_card_rv"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/after_progress_layout"
                     />

                <LinearLayout
                    android:id="@+id/after_map_accordion_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/stroke_gray800"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/after_card_rv">

                    <LinearLayout
                        android:id="@+id/after_btn_toggle_map"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/after_iv_map_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_arrow_down"
                            android:layout_marginEnd="6dp"
                            app:tint="@color/white"/>

                        <TextView
                            android:id="@+id/after_tv_map_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="지도로 보기"
                            android:textColor="@color/white"
                            android:textAppearance="@style/caption1_Semibold"/>
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/after_layout_map_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:paddingBottom="14dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <androidx.fragment.app.FragmentContainerView
                                android:id="@+id/after_naver_map_fragment"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                        </androidx.cardview.widget.CardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/after_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="30dp"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/brand_500"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/brand_500"
                app:tabTextAppearance="@style/body2_Semibold"
                app:tabTextColor="@color/gray_600" />

            <FrameLayout
                android:id="@+id/after_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="40dp"
                />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/brand_100"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>